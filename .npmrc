registry=https://registry.npmjs.org/
@navikt:registry=https://npm.pkg.github.com
@nais:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
# Allow npm to install packages that have peer dependencies that are not
# explicitly listed in the package's dependencies or devDependencies. This is
# useful for packages that have optional peer dependencies or for packages that
# have peer dependencies that are not compatible with the current version of npm.
legacy-peer-deps=true
# Reject packages that declare incompatible Node.js or npm versions in their
# engines field.
engine-strict=true